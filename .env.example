# Copier ce fichier en .env (cp .env.example .env) puis remplir les valeurs.
# .env est ignoré par Git : ne JAMAIS committer de vraies clés.

# --- France Travail (francetravail.io) : La Bonne Boîte, Marché du travail, ROME 4.0, Offres d'emploi (si accès)
# OAuth2 client_credentials : les DEUX valeurs sont nécessaires pour obtenir un jeton.
FT_CLIENT_ID=
FT_CLIENT_SECRET=
FT_TOKEN_URL=https://entreprise.francetravail.fr/connexion/oauth2/access_token?realm=%2Fpartenaire
# Scopes séparés par des espaces : ceux des API souscrites, visibles dans l'espace francetravail.io de l'application
FT_SCOPES=api_labonneboitev2 search office api_rome-metiersv1 nomenclatureRome api_stats-offres-demandes-emploiv1 offresetdemandesemploi

# --- Adzuna (developer.adzuna.com) : les deux sont nécessaires
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- La bonne alternance (api.apprentissage.beta.gouv.fr)
LBA_API_TOKEN=

# --- LLM (bonus, facultatif)
ANTHROPIC_API_KEY=

# --- S3 Onyxia : rien à mettre ici, les variables AWS_* sont injectées automatiquement dans le service Onyxia.
